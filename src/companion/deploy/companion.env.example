# Companion environment — install to /etc/companion/companion.env (chmod 600).
# Never commit the real file. Generate the key once and keep a safe backup.
#
#   python -c "from serving.privacy import Encryptor; print(Encryptor.generate_key())"

# REQUIRED — decrypts your memory. Losing this = memory is unrecoverable.
SUD_PHI_KEY=paste-a-fernet-key-here

# Local ASR (whisper.cpp) — build on the Pi, then point here.
WHISPER_BIN=/home/pi/whisper.cpp/main
WHISPER_MODEL=/home/pi/whisper.cpp/models/ggml-base.en.bin

# Local TTS (Piper) — binary + a voice (.onnx alongside its .onnx.json).
PIPER_BIN=piper
PIPER_VOICE=/home/pi/voices/en_US-amy-medium.onnx

# Local LLM. Standalone on this Pi 5:
COMPANION_LOCAL_URL=http://localhost:11434/v1
COMPANION_LOCAL_MODEL=llama3.2:3b
# ...or point at a beefier box on YOUR LAN (still closed — never leaves the network):
# COMPANION_LOCAL_URL=http://192.168.1.50:11434/v1
# COMPANION_LOCAL_MODEL=llama3.1:8b
