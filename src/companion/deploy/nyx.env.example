# Nyx brain env — install to ~/.config/companion/nyx.env on the Studio, chmod 600.
# Paste your real Fernet key (the same one that decrypts her memory).
#
# Tradeoff to know: for boot-start there's no human to type the key, so it lives
# in this 0600 file on the same machine as the encrypted memory. That's the cost
# of "just works on boot." For more security, store the key in the macOS Keychain
# and have nyx-brain.sh read it via `security find-generic-password` instead.
SUD_PHI_KEY=paste-your-44-char-fernet-key-here
COMPANION_LOCAL_URL=http://localhost:11434/v1
COMPANION_LOCAL_MODEL=llama3.1:8b
WHISPER_REMOTE_URL=http://localhost:8080
